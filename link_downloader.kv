#:kivy 2.3.0

<ActionButton@Button>:
    size_hint_y: None
    height: "48dp"
    background_normal: ""
    background_down: ""
    background_color: (0.09, 0.39, 0.36, 1) if not self.disabled else (0.45, 0.49, 0.51, 1)
    color: (1, 1, 1, 1)
    font_size: "15sp"

<PanelLabel@Label>:
    color: (0.10, 0.12, 0.14, 1)
    font_size: "14sp"
    text_size: self.width, None
    halign: "left"
    valign: "middle"

DownloaderRoot:
    url_input: url_input
    option_spinner: option_spinner
    analyze_button: analyze_button
    download_button: download_button
    progress_bar: progress_bar
    orientation: "vertical"
    padding: "18dp"
    spacing: "12dp"
    canvas.before:
        Color:
            rgba: (0.95, 0.96, 0.94, 1)
        Rectangle:
            pos: self.pos
            size: self.size

    Label:
        text: "Link Downloader"
        size_hint_y: None
        height: "38dp"
        color: (0.05, 0.08, 0.10, 1)
        font_size: "24sp"
        bold: True
        text_size: self.width, None
        halign: "left"
        valign: "middle"

    Label:
        text: "Only download videos you own or have permission to save."
        size_hint_y: None
        height: "24dp"
        color: (0.45, 0.22, 0.18, 1)
        font_size: "12sp"
        text_size: self.width, None
        halign: "left"
        valign: "middle"

    TextInput:
        id: url_input
        hint_text: "Paste video link"
        multiline: False
        size_hint_y: None
        height: "52dp"
        font_size: "16sp"
        padding: ["12dp", "14dp", "12dp", "10dp"]
        foreground_color: (0.05, 0.08, 0.10, 1)
        background_color: (1, 1, 1, 1)

    BoxLayout:
        size_hint_y: None
        height: "48dp"
        spacing: "10dp"

        ActionButton:
            id: analyze_button
            text: "Check Link"
            on_release: root.analyze_url()

        Spinner:
            id: option_spinner
            text: "Best MP4"
            values: ["Best MP4", "Small MP4", "Audio M4A"]
            size_hint_x: 0.75
            background_normal: ""
            background_down: ""
            background_color: (1, 1, 1, 1)
            color: (0.05, 0.08, 0.10, 1)

    ActionButton:
        id: download_button
        text: "Download"
        disabled: True
        on_release: root.download_selected()

    ProgressBar:
        id: progress_bar
        max: 100
        value: 0
        size_hint_y: None
        height: "12dp"

    PanelLabel:
        text: root.status_text
        size_hint_y: None
        height: max(self.texture_size[1] + dp(8), dp(34))

    Label:
        text: root.info_text
        size_hint_y: 1
        color: (0.10, 0.12, 0.14, 1)
        font_size: "14sp"
        text_size: self.width, self.height
        halign: "left"
        valign: "top"

    PanelLabel:
        text: root.download_dir_text
        size_hint_y: None
        height: max(self.texture_size[1] + dp(8), dp(32))
